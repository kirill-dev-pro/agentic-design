# Serves site/dist (site/build.mjs) on :3000, as Bunderhost runs it (Dockerfile.bunderhost).
# Locally: caddy run --config site/Caddyfile --adapter caddyfile  (with SITE_ROOT=site/dist)
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:3000} {
	root * {$SITE_ROOT:/srv}

	# Bunderhost's health check
	handle /api/health {
		header Content-Type application/json
		respond `{"ok":true}` 200
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "interest-cohort=()"
		-Server
	}

	# names with a content hash never change
	@hashed path_regexp \.[0-9a-f]{10}\.(css|js|wasm|woff2|png|svg|jpg|webp)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@stable path /favicon.ico /img/* /robots.txt /sitemap.xml /site.webmanifest /view/samples/*
	header @stable Cache-Control "public, max-age=86400"
	@pages path / /index.html /view /view/ /view/index.html /404.html
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	redir /view /view/ 308

	file_server {
		precompressed br gzip
	}
	handle_errors 404 {
		rewrite * /404.html
		file_server {
			precompressed br gzip
		}
	}
}
