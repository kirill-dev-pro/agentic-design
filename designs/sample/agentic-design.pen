    {
      "name": "Landing",
      "nodes": [
        "d-root",
        "m-root"
      ]
    },
    {
      "name": "Components",
      "nodes": [
        "btn-primary",
        "btn-secondary",
        "logo",
        "nav",
        "sec-head",
        "feature",
        "tool",
        "check",
        "code",
        "cursor",
        "footer"
      ]
