                    "sec-eyebrow": {
                      "content": "MCP TOOLS"
                    },
                    "sec-lede": {
                      "content": "agentic-design mcp is a stdio MCP server. It forwards tool calls to the running window and opens the window itself when it is closed. The onboarding registers it with Claude Code, Codex, Cursor and six more clients in a click."
                    },
                    "sec-title": {
                      "content": "One command to connect"
                    }
                  },
                  "ref": "sec-head",
                  "width": "fill_container"
                },
                {
                  "type": "ref",
                  "id": "m-tl-code",
                  "descendants": {
                    "code-text": {
                      "content": "$ claude mcp add --scope user \\\n  agentic-design -- \\\n  /path/to/agentic-design mcp"
                    },
                    "code-title": {
                      "content": "Terminal"
                    }
                  },
                  "ref": "code",
