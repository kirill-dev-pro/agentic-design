  "children": [
    {
      "type": "frame",
      "id": "d-root",
      "name": "Landing / Desktop",
      "fill": "$bg",
      "layout": "vertical",
      "theme": {
        "viewport": "desktop"
      },
      "width": "$page-width",
      "x": 0,
      "y": 0,
      "children": [
        {
          "type": "ref",
          "id": "d-nav",
          "ref": "nav",
          "width": "fill_container"
        },
        {
          "type": "frame",
          "id": "d-hero",
          "name": "Hero",
          "alignItems": "center",
          "gap": 28,
          "layout": "vertical",
          "padding": [
            96,
            "$section-pad-x",
            0,
            "$section-pad-x"
          ],
          "width": "fill_container",
          "children": [
            {
              "type": "frame",
              "alignItems": "center",
              "cornerRadius": 16,
              "fill": "$accent-soft",
              "justifyContent": "center",
              "layout": "horizontal",
              "padding": [
                6,
                12
              ],
              "stroke": "$accent-soft",
              "strokeAlignment": "inner",
              "strokeWidth": 1,
              "id": "d-badge",
              "name": "Badge",
              "children": [
                {
                  "type": "text",
                  "id": "d-badge-label",
                  "content": "Prototype · free and open · macOS",
                  "fill": "$accent",
                  "fontFamily": "$font-sans",
                  "fontSize": 13,
                  "fontWeight": "500",
                  "lineHeight": 1.333,
                  "textGrowth": "auto"
                }
              ]
            },
            {
              "type": "text",
              "id": "d-h1",
              "content": "A design canvas your agent can see",
              "fill": "$text",
              "fontFamily": "$font-sans",
              "fontSize": "$size-h1",
              "fontWeight": "700",
              "letterSpacing": -2,
              "lineHeight": 1.04,
              "textAlign": "center",
              "textGrowth": "fixed-width",
              "width": 900
            },
            {
              "type": "text",
              "id": "d-lede",
              "content": "Agentic Design is a native macOS editor for .pen files. Your agent reads the document, draws into it and screenshots the result over MCP, while you watch and edit the same canvas live.",
              "fill": "$text-muted",
              "fontFamily": "$font-sans",
              "fontSize": "$size-body",
              "fontWeight": "400",
              "lineHeight": 1.55,
              "textAlign": "center",
              "textGrowth": "fixed-width",
              "width": 680
            },
            {
              "type": "frame",
              "id": "d-ctas",
              "name": "Buttons",
              "alignItems": "center",
              "gap": 12,
              "layout": "horizontal",
              "width": "fit_content",
              "children": [
                {
                  "type": "ref",
                  "id": "d-cta1",
                  "descendants": {
                    "btn-primary-label": {
                      "content": "Get it for macOS"
                    }
                  },
                  "ref": "btn-primary"
                },
                {
                  "type": "ref",
                  "id": "d-cta2",
                  "descendants": {
                    "btn-secondary-icon": {
                      "icon": "plug"
                    },
                    "btn-secondary-label": {
                      "content": "Connect an agent"
                    }
                  },
                  "ref": "btn-secondary"
                }
              ]
            },
            {
              "type": "frame",
              "id": "d-hero-art",
              "name": "Art",
              "layout": "vertical",
              "padding": [
                32,
                0,
                0,
                0
              ],
              "width": "fill_container",
              "children": [
                {
                  "type": "frame",
                  "id": "d-m-mock",
                  "name": "App window",
                  "clip": true,
                  "cornerRadius": 14,
                  "effect": {
                    "blur": 64,
                    "color": "$shadow-window",
                    "offset": {
                      "x": 0,
                      "y": 24
                    },
                    "shadowType": "outer",
                    "type": "shadow"
                  },
                  "fill": "$surface",
                  "height": 620,
                  "layout": "none",
                  "stroke": "$border",
                  "strokeAlignment": "inner",
                  "strokeWidth": 1,
                  "width": "fill_container",
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "d-m-bar",
                      "fill": "$surface-2",
                      "height": 40,
                      "width": 1200,
                      "x": 0,
                      "y": 0
                    },
                    {
                      "type": "ellipse",
