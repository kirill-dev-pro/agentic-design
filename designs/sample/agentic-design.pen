        {
          "type": "frame",
          "id": "d-what",
          "name": "What it is",
          "gap": "$section-gap",
          "layout": "vertical",
          "padding": [
            "$section-pad-y",
            "$section-pad-x"
          ],
          "width": "fill_container",
          "children": [
            {
              "type": "ref",
              "id": "d-what-h",
              "descendants": {
                "sec-eyebrow": {
                  "content": "WHAT IT IS"
                },
                "sec-lede": {
                  "content": "Agents already write code on your computer. Agentic Design gives them a canvas: the same document you edit, drawn natively, with tools made for how agents work."
                },
                "sec-title": {
                  "content": "A canvas built for agents, and for you"
                }
              },
              "ref": "sec-head",
              "width": 720
            },
            {
              "type": "frame",
              "id": "d-cards",
              "name": "Cards",
              "gap": 24,
              "layout": "horizontal",
              "width": "fill_container",
              "children": [
                {
                  "type": "ref",
                  "id": "d-card1",
                  "descendants": {
                    "feature-body": {
                      "content": "Written in Odin and drawn with NanoVG. One small binary: no browser, plugin or server to keep alive."
                    },
                    "feature-icon": {
                      "icon": "app-window"
                    },
                    "feature-title": {
                      "content": "Native on macOS"
                    }
                  },
                  "ref": "feature",
                  "width": "fill_container"
                },
                {
                  "type": "ref",
                  "id": "d-card2",
                  "descendants": {
                    "feature-body": {
                      "content": "They read the document, create nodes in the JSON the file stores, and check their work with screenshot and lint."
                    },
                    "feature-icon": {
                      "icon": "bot"
                    },
                    "feature-title": {
                      "content": "Agents are first-class users"
                    }
                  },
                  "ref": "feature",
                  "width": "fill_container"
                },
                {
                  "type": "ref",
                  "id": "d-card3",
                  "descendants": {
                    "feature-body": {
                      "content": "Your designs are plain .pen files on your disk, readable by people, agents and pencil.design."
                    },
                    "feature-icon": {
                      "icon": "heart"
                    },
                    "feature-title": {
                      "content": "Free and open"
                    }
                  },
                  "ref": "feature",
                  "width": "fill_container"
                }
              ]
            }
          ]
        },
