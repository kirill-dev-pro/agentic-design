{
	"name": "Agentic Design viewer",
	"short_name": ".pen viewer",
	"description": "Open .pen design files, drawn by the Agentic Design engine. Files stay on your device.",
	"start_url": "/view/",
	"scope": "/view/",
	"display": "standalone",
	"background_color": "#1e1e1e",
	"theme_color": "#1e1e1e",
	"icons": [
		{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/img/icon-512.png", "sizes": "512x512", "type": "image/png" }
	],
	"file_handlers": [
		{ "action": "/view/", "accept": { "application/x-pen": [".pen"] } }
	]
}
